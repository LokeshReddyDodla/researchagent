{
  "compilerOptions": {
    "composite": true,
    // Composite projects must emit, but we never want the compiled
    // vite.config.js in the project root — it would shadow vite.config.ts
    // (Vite loads .js first). Redirect all emit + build info into a temp dir.
    "outDir": "./node_modules/.tmp/node",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "types": ["node"],
    "strict": true
  },
  "include": ["vite.config.ts"]
}
