# Copy to .env.local and edit. Vite reads env vars prefixed with VITE_.

# Where Vite's dev proxy forwards /v1/*, /docs, /openapi.json.
# Default: http://localhost:8000 (the aihealth-server FastAPI container).
VITE_API_PROXY_TARGET=http://localhost:8000

# Direct API base URL — leave empty in dev so requests stay same-origin
# (and ride through the Vite proxy). Set to e.g. https://api.example.com
# only if you want to bypass the proxy and talk to the backend directly.
# VITE_API_BASE_URL=
